# ==============================================================================
# NyayaLens Environment Configuration Template
# Copy this file to .env or export these variables in your hosting provider (Render/Vercel)
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Server & Profile Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
APP_ENV=development

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left blank, NyayaLens automatically operates in high-fidelity deterministic fallback mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Security & CORS
# Comma-separated list of allowed web origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting (Per-minute IP/Session limits)
RATE_LIMIT_ANALYZE_RPM=10
RATE_LIMIT_COMPARE_RPM=10
RATE_LIMIT_QUESTION_RPM=30
RATE_LIMIT_GENERAL_RPM=60

# Document Ingestion Controls
MAX_UPLOAD_SIZE_MB=15
MAX_DOCUMENT_PAGES=50
DOCUMENT_SESSION_TTL_MINUTES=60

# Optional Database Configuration (for 'mysql' profile)
# If using hosted in-memory profile, leave default
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nyayalens
DB_USERNAME=nyaya_user
DB_PASSWORD=your_secure_db_password
